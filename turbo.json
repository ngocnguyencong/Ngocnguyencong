{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["CI", "EXPO_NO_TELEMETRY", "EXPO_OFFLINE"],
  "globalEnv": ["APP_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
