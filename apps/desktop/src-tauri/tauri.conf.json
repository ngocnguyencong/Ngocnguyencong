{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supastack",
  "version": "0.1.0",
  "identifier": "com.supastack.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {}
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["supastack"]
      }
    },
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "placeholder-icons/32x32.png",
      "placeholder-icons/128x128.png",
      "placeholder-icons/128x128@2x.png",
      "placeholder-icons/icon.icns",
      "placeholder-icons/icon.ico"
    ]
  }
}
