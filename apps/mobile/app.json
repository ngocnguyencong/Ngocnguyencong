{
  "expo": {
    "name": "supastack",
    "slug": "supastack",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.supastack.app"
    },
    "android": {
      "package": "com.supastack.app"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"]
  }
}
