{
  "name": "@supastack/mobile",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "build": "node scripts/export.mjs",
    "build:android": "eas build --platform android --profile production",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "ios": "expo start --ios",
    "start": "expo start",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.2",
    "@supastack/design-tokens": "workspace:*",
    "@supastack/ui-native": "workspace:*",
    "better-auth": "1.7.2",
    "expo": "57.0.19",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.7",
    "expo-notifications": "~57.0.22",
    "expo-router": "57.0.18",
    "expo-secure-store": "57.0.3",
    "expo-web-browser": "57.0.2",
    "react": "catalog:",
    "react-native": "0.86.3",
    "react-native-purchases": "10.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "19.2.7",
    "tsx": "4.23.13",
    "typescript": "catalog:",
    "vitest": "4.1.11"
  }
}
