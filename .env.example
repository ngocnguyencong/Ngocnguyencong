APP_ENV=local
APP_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_SCHEME=supastack
# Optional server-only Expo access token — adds `Authorization: Bearer` to
# Expo push API sends (per-token security, higher rate limits).
EXPO_ACCESS_TOKEN=
# Comma-separated absolute origins added to auth trusted origins for the
# mobile/desktop shells. Empty falls back to APP_URL. Required when
# APP_ENV=production: exact non-local HTTPS origins only — no wildcards.
MOBILE_ALLOWED_ORIGINS=

# Native purchases: off by default. MOBILE_PURCHASES_PROVIDER accepts
# off|revenuecat only — "fake" is valid solely for
# EXPO_PUBLIC_MOBILE_PURCHASES_PROVIDER (explicit mobile development).
MOBILE_PURCHASES_PROVIDER=off
EXPO_PUBLIC_MOBILE_PURCHASES_PROVIDER=off
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Server-only RevenueCat verification and exact webhook Authorization header.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_ENTITLEMENT_ID=pro
REVENUECAT_ENTITLEMENT_KEY=ai.reference-task
# Sandbox grants are always rejected when APP_ENV=production.
REVENUECAT_ALLOW_SANDBOX=
DATABASE_URL=postgres://supastack:supastack@localhost:5432/supastack
# Optional self-hosted Postgres/MinIO Compose overrides. These values are
# local-only examples; use unique generated credentials for any VPS deployment.
# POSTGRES_PASSWORD=supastack
# MINIO_ROOT_USER=supastack
# MINIO_ROOT_PASSWORD=supastack
AUTH_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
AUTH_GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_TWITTER_ENABLED=false
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
AUTH_MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Connected accounts (workspace external accounts, e.g. Settings → Connections).
# These are OAuth *app* credentials per provider — separate from the sign-in
# providers above. An empty client id disables that provider's connect flow.
# X supports public PKCE-only clients (secret optional); Google and Microsoft
# are confidential clients — without a secret they stay DISABLED even when the
# client id is set. Callback URL to register per provider:
# {APP_URL}/api/accounts/{x|google|microsoft}/callback
CONNECTED_X_CLIENT_ID=
CONNECTED_X_CLIENT_SECRET=
CONNECTED_GOOGLE_CLIENT_ID=
CONNECTED_GOOGLE_CLIENT_SECRET=
CONNECTED_MICROSOFT_CLIENT_ID=
CONNECTED_MICROSOFT_CLIENT_SECRET=
# Bot protection: "off" (default) skips checks; "turnstile" enforces Cloudflare
# Turnstile on the contact/newsletter forms and better-auth credential endpoints
# (sign-in, sign-up, OTP, password reset). Both keys required when enabled.
CAPTCHA_PROVIDER=off
# TURNSTILE_SECRET_KEY is server-only (siteverify); the site key is public.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
AI_PROVIDER=fake
# Optional server-only catalog model IDs, in preferred/fallback order. [] disables an alias.
# AI_MODEL_POLICY='{"fast":["model-small"],"smart":["model-large","model-small"],"cheap":[]}'
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
# AI_PROVIDER=openrouter routes every catalog model through OpenRouter
# (model IDs look like "anthropic/claude-sonnet-4"). OPENROUTER_APP_NAME /
# OPENROUTER_SITE_URL are optional attribution headers (X-Title / HTTP-Referer).
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=
OPENROUTER_SITE_URL=
# Agent framework used by server-side agent runs: ai-sdk (default) | mastra |
# langgraph | openai-agents. Workspace tools are shared with the /api/mcp server.
AGENT_FRAMEWORK=ai-sdk
# EMAIL_PROVIDER: local | resend | ses | postmark | sendgrid | mailgun | smtp | brevo
EMAIL_PROVIDER=local
EMAIL_FROM=Supastack <hello@example.test>
RESEND_API_KEY=
AWS_REGION=us-east-1
# ses uses the AWS SDK. Leave keys blank for an IAM role or local AWS profile.
# Explicit credentials require both values; these are API keys, not SMTP credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required with temporary explicit AWS credentials; leave blank for long-lived keys.
AWS_SESSION_TOKEN=
# postmark | sendgrid | mailgun | smtp | brevo route through @opencoredev/email-sdk
# (telemetry is disabled by the app; EMAIL_SDK_TELEMETRY=0 or DO_NOT_TRACK=1 also opt out).
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# MAILGUN_REGION: us (default) | eu
MAILGUN_REGION=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SECURE: true for implicit TLS (port 465); empty/false uses STARTTLS.
SMTP_SECURE=
BREVO_API_KEY=
# BILLING_PROVIDER: local | stripe | lemonsqueezy | creem | polar | whop | paddle | dodo | paypal
BILLING_PROVIDER=local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Lemon Squeezy: VARIANT_ID is the default price; store/api/webhook secrets stay server-only.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Creem (Merchant of Record): PRODUCT_ID is the default product; api/webhook
# secrets stay server-only. CREEM_TEST_MODE=true points the API at the sandbox.
CREEM_API_KEY=
CREEM_PRODUCT_ID=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=
# Optional per-plan Creem products (Monthly/Yearly toggle + Lifetime).
# CREEM_PRODUCT_ID_PRO=
# CREEM_PRODUCT_ID_PRO_YEARLY=
# CREEM_PRODUCT_ID_LIFETIME=
# Polar (Merchant of Record): PRODUCT_ID is the default product; access token
# and webhook secret stay server-only. POLAR_SERVER: sandbox | production.
# Webhook endpoint: /api/billing/webhook/polar (Standard Webhooks headers).
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
# Optional per-plan Polar products (Monthly/Yearly toggle + Lifetime).
# POLAR_PRODUCT_ID_PRO=
# POLAR_PRODUCT_ID_PRO_YEARLY=
# POLAR_PRODUCT_ID_LIFETIME=
# Whop: PLAN_ID is the default plan; api/webhook secrets stay server-only.
# Webhook endpoint: /api/billing/webhook/whop (Standard Webhooks headers).
WHOP_API_KEY=
WHOP_PLAN_ID=
WHOP_WEBHOOK_SECRET=
# Optional per-plan Whop plans (Monthly/Yearly toggle + Lifetime).
# WHOP_PLAN_ID_PRO=
# WHOP_PLAN_ID_PRO_YEARLY=
# WHOP_PLAN_ID_LIFETIME=
# Paddle (Merchant of Record): PRICE_ID is the default price; api/webhook
# secrets stay server-only. PADDLE_ENVIRONMENT: sandbox | production.
# Webhook endpoint: /api/billing/webhook/paddle (Paddle-Signature header).
PADDLE_API_KEY=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
# Optional per-plan Paddle prices (Monthly/Yearly toggle + Lifetime).
# PADDLE_PRICE_ID_PRO=
# PADDLE_PRICE_ID_PRO_YEARLY=
# PADDLE_PRICE_ID_LIFETIME=
# Dodo Payments (Merchant of Record): PRODUCT_ID is the default product; api
# key and webhook key stay server-only. DODO_PAYMENTS_ENVIRONMENT:
# test_mode | live_mode.
# Webhook endpoint: /api/billing/webhook/dodo (Standard Webhooks headers).
DODO_PAYMENTS_API_KEY=
DODO_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Optional per-plan Dodo products (Monthly/Yearly toggle + Lifetime).
# DODO_PRODUCT_ID_PRO=
# DODO_PRODUCT_ID_PRO_YEARLY=
# DODO_PRODUCT_ID_LIFETIME=
# PayPal subscriptions: PLAN_ID is the default billing plan; OAuth client
# credentials and the webhook id stay server-only. PAYPAL_ENVIRONMENT:
# sandbox | live.
# Webhook endpoint: /api/billing/webhook/paypal (PayPal-* transmission headers).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
# Optional per-plan PayPal billing plans (Monthly/Yearly toggle + Lifetime).
# PAYPAL_PLAN_ID_PRO=
# PAYPAL_PLAN_ID_PRO_YEARLY=
# PAYPAL_PLAN_ID_LIFETIME=
# Optional per-plan Stripe prices (Monthly/Yearly toggle + Lifetime).
# STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_YEARLY=
# STRIPE_PRICE_ID_LIFETIME=
JOB_PROVIDER=local
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# SCHEDULER_TICK_SECRET authenticates the internal scheduler tick endpoint
# POST /api/internal/scheduler-tick — the local/dev/CI driver for job_schedule
# rows (rate-limit pruning, token sweeps) when Trigger.dev isn't running the
# scheduler.tick cron. Unset → the endpoint 404s (disabled, even in dev).
# Schedule cron fields are evaluated in UTC — plan off-peak times accordingly.
# Generate with: openssl rand -hex 32
# Tick manually: pnpm jobs:tick  (or curl -X POST -H "x-scheduler-key:
# $SCHEDULER_TICK_SECRET" localhost:3000/api/internal/scheduler-tick)
# SCHEDULER_TICK_URL overrides the jobs:tick target (default: APP_URL,
# then http://localhost:3000).
# SCHEDULER_TICK_URL=
SCHEDULER_TICK_SECRET=

# STORAGE_PROVIDER: memory (default) | s3. S3 needs bucket + credentials;
# STORAGE_ENDPOINT selects an S3-compatible service (Supabase Storage, MinIO).
# forcePathStyle defaults to true when an endpoint is set (required by
# Supabase/MinIO); set it false for a virtual-hosted custom endpoint.
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# STORAGE_REGION=us-east-1            # Supabase: project region; AWS: real region
# STORAGE_FORCE_PATH_STYLE=true
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_BASE_URL=            # optional CDN base for getPublicUrl

# RATE_LIMIT_STORE: memory | postgres. Unset: postgres when
# NODE_ENV=production, memory otherwise. postgres shares fixed-window buckets
# across every server instance (requires DATABASE_URL). On store failure the
# production limiters (public API, auth, webhooks) fail CLOSED — requests are
# rejected, not waved through — so a database outage shows as 429s, not open
# traffic.
# NODE_ENV=production without APP_ENV also validates as production (the full
# production env set is then required).
# NODE_ENV=
# RATE_LIMIT_STORE=postgres

# TRUSTED_PROXY_COUNT: 0-10, default 0. Number of reverse proxies that append
# x-forwarded-for in front of the app — count only hops you control (one
# Traefik/Caddy/Nginx = 1). The client-IP bucket key is read that many entries
# from the right; 0 trusts no forwarding entries (shared "unknown" bucket).
# Set 1 only when one controlled proxy appends x-forwarded-for.
# TRUSTED_PROXY_COUNT=0

# PUBLIC_AI_DAILY_BUDGET_MICROUNITS: non-negative integer string (microunits
# per UTC day) capping anonymous/public AI spend platform-wide. Default "0"
# disables public AI endpoints entirely — reservations then throw
# PublicAiBudgetExceededError before any provider call.
# PUBLIC_AI_DAILY_BUDGET_MICROUNITS=5000000

# CUSTOM_DOMAINS_PROVIDER: off (default) | local | cloudflare.
# cloudflare = Cloudflare for SaaS custom hostnames: the API token needs
# SSL and Certificates:Edit on the zone; CNAME_TARGET is the hostname in
# your zone customers point CNAMEs at. local marks every hostname active.
# CUSTOM_DOMAINS_PROVIDER=off
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CUSTOM_DOMAIN_CNAME_TARGET=customers.example.com

# Supabase (managed or self-hosted Postgres + S3 storage).
# The supabase:provision script creates a cloud project via the Management
# API — needs a token from supabase.com/dashboard/account/tokens (never
# printed); it ships where the Supabase helper scripts do (web workspace).
# SUPABASE_ACCESS_TOKEN=
# Cloud: DATABASE_URL=postgres://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   Session pooler (5432) = migrations/long-lived; transaction pooler (6543,
#   pgbouncer) = serverless. Prepared statements are disabled automatically
#   on 6543 / ?pgbouncer=true / DATABASE_POOLER=transaction.
# Self-hosted: DATABASE_URL=postgres://postgres.<tenant>:<pw>@<host>:5432/postgres
#   (tenant = pooler_tenant_id; direct Postgres also works inside the network).
# DATABASE_POOLER=transaction
# The supabase:doctor script checks SSL, pooler mode, pending migrations,
# and public-schema RLS exposure (PostgREST); its --fix-rls mode hardens it.
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional HTTPS endpoint for failure alerts — receives {text,name,severity,context} JSON POSTs (Slack-compatible {text} shape).
ALERT_WEBHOOK_URL=

# Site analytics: ANALYTICS_PROVIDER selects the product/marketing analytics
# adapter — off (default) | local | plausible | posthog. local collects
# consent-gated pageviews/events into the analytics_event table via
# POST /api/analytics/collect and summarizes them on the admin overview.
# plausible/posthog inject the vendor script only after consent; both then
# require ANALYTICS_SITE_ID (Plausible data-domain / PostHog project key).
# ANALYTICS_HOST optionally overrides the script+API origin for self-hosted
# or EU instances (https only; defaults https://plausible.io /
# https://us.i.posthog.com). Rows never store raw IP or user-agent —
# visitorHash is a daily-rotating salted hash.
ANALYTICS_PROVIDER=off
ANALYTICS_SITE_ID=
ANALYTICS_HOST=

# Marketing leads (contact form + newsletter): MARKETING_INBOX gets a
# notification email per lead; MARKETING_LEAD_STORE additionally persists
# leads — local (.data/marketing-leads.json, dev only) | firestore.
MARKETING_INBOX=
MARKETING_LEAD_STORE=
# MARKETING_LEAD_STORE_PATH=   # optional local JSON path override
# Firebase Admin SDK creds — required when MARKETING_LEAD_STORE=firestore.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIRESTORE_DATABASE: named database id; defaults to "(default)".
FIRESTORE_DATABASE=

# Platform admins (comma-separated emails) get the admin role on signup.
# Server-only; without it no bootstrap admin exists until one is granted in the DB.
ADMIN_EMAILS=
# AUTH_PROVIDER: better-auth (full feature set) | authjs (Auth.js v5 engine)
AUTH_PROVIDER=better-auth

# Desktop shell (apps/desktop): web app URL the Tauri window loads
# (runtime env wins over the compile-time value; default http://localhost:3000).
SUPASTACK_APP_URL=http://localhost:3000
# Optional global-hotkey override for the show/hide shortcut
# (Tauri accelerator syntax, default CmdOrCtrl+Shift+Space).
# SUPASTACK_DESKTOP_HOTKEY=CmdOrCtrl+Shift+Space

# Desktop updater signing (release builds only — see docs/desktop-updates.md).
# Both are required as a pair for `pnpm --filter @supastack/desktop
# check:release-config` to emit the `plugins.updater` build overlay:
# endpoint is the HTTPS latest.json URL template containing
# {{current_version}} (and usually {{target}}/{{arch}}); pubkey is the
# minisign public key. The private key stays in CI secrets, never here.
# SUPASTACK_UPDATER_ENDPOINT=
# SUPASTACK_UPDATER_PUBKEY=

# Sub-repo sync targets for `pnpm sync:subrepos` (optional — defaults derive
# from the origin remote's org: <org>/supastack-{web,mobile,desktop}.git).
# SUBREPO_HOME is the staging parent for the sub-repo clones (default
# .subrepos/; ".." keeps them as sibling checkouts, e.g. ../supastack-web).
# SUBREPO_WEB_REMOTE=
# SUBREPO_MOBILE_REMOTE=
# SUBREPO_DESKTOP_REMOTE=
# SUBREPO_HOME=

# Early access gate: "true" requires a valid invite code to create an account
# (issue codes from /admin/waitlist). Existing sessions, ADMIN_EMAILS bootstrap,
# and admin-created users are unaffected.
EARLY_ACCESS_INVITE_ONLY=false
